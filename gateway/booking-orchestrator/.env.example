# Local development. Production validation is stricter; see README.md.
ESB_ENVIRONMENT=development
ESB_DATABASE_URL=sqlite:////tmp/esb_workflows.db
ESB_DOCS_ENABLED=true
ESB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Host-mode service registry. Frontend calls only ESB port 8000, including authentication.
ESB_IDENTITY_SERVICE_URL=http://localhost:8009
ESB_CUSTOMER_SERVICE_URL=http://localhost:8001
ESB_EVENT_SERVICE_URL=http://localhost:8002
ESB_SEAT_SERVICE_URL=http://localhost:8003/soap
ESB_BOOKING_SERVICE_URL=http://localhost:8004
ESB_PAYMENT_SERVICE_URL=http://localhost:8005
ESB_TICKET_SERVICE_URL=http://localhost:8006
ESB_NOTIFICATION_SERVICE_URL=http://localhost:8007
ESB_REALTIME_SERVICE_URL=http://localhost:8008

# Public JWT verification. HS256 is a controlled local fallback only.
ESB_IDENTITY_JWKS_URL=http://localhost:8009/.well-known/jwks.json
ESB_IDENTITY_EXPECTED_ISSUER=http://localhost:8009
ESB_IDENTITY_EXPECTED_AUDIENCE=public-esb
# ESB_JWT_SHARED_SECRET=local-only-shared-secret

# Internal service JWT. Production uses an RS256 private key mounted as a secret.
ESB_INTERNAL_SERVICE_ISSUER=booking-orchestrator
ESB_INTERNAL_SERVICE_SUBJECT=booking-orchestrator
ESB_INTERNAL_SERVICE_KEY_ID=esb-internal-1
# ESB_INTERNAL_SERVICE_PRIVATE_KEY_PATH=/run/secrets/esb_internal_private.pem
# ESB_SERVICE_TOKEN=local-static-token-only

# Notification webhook HMAC. Use a distinct random value in every environment.
ESB_NOTIFICATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# One-time Realtime WebSocket ticket. Production uses an RS256 key.
ESB_WS_TICKET_ISSUER=booking-orchestrator
ESB_WS_TICKET_AUDIENCE=realtime-status-service
ESB_WS_TICKET_KEY_ID=esb-ws-1
# ESB_WS_TICKET_PRIVATE_KEY_PATH=/run/secrets/esb_ws_private.pem
ESB_WS_TICKET_SIGNING_SECRET=local-only-signing-secret-at-least-32-bytes
ESB_WS_TICKET_TTL_SECONDS=45

# Orchestration and resilience policy.
ESB_REQUEST_TIMEOUT_SECONDS=15
ESB_DEPENDENCY_TIMEOUT_SECONDS=4
ESB_MAX_SAFE_READ_ATTEMPTS=3
ESB_MAX_IDEMPOTENT_COMMAND_ATTEMPTS=2
ESB_BULKHEAD_LIMIT=20
ESB_RESERVATION_TTL_SECONDS=600
ESB_RECONCILIATION_POLL_SECONDS=2
ESB_RECONCILIATION_BATCH_SIZE=50
ESB_OUTBOX_MAX_ATTEMPTS=8
ESB_OUTBOX_BATCH_SIZE=50
ESB_ENABLE_WORKERS=true
