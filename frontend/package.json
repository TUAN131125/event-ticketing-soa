{
  "name": "event-ticketing-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "shared-ui",
    "customer-web",
    "admin-web"
  ],
  "scripts": {
    "generate:contracts": "node scripts/generate-esb-types.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run generate:contracts && npm run verify:esb-contract && npm run format:check",
    "format": "prettier --write \"{admin-web,customer-web,shared-ui}/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{admin-web,customer-web,shared-ui}/src/**/*.{ts,tsx,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:esb-contract": "node scripts/verify-esb-consumer-contract.mjs",
    "generate:esb-contract:fallback": "python scripts/generate_esb_types.py",
    "verify:esb-contract:fallback": "python scripts/verify_esb_consumer_contract.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.6",
    "yaml": "2.8.3"
  }
}
