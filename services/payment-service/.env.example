PAYMENT_APP_ENV=local
PAYMENT_DATABASE_URL=postgresql+psycopg://payment:payment@localhost:5438/payment
PAYMENT_SERVICE_TOKEN=local-development-token
PAYMENT_DB_POOL_SIZE=10
PAYMENT_DB_MAX_OVERFLOW=20
PAYMENT_DB_POOL_TIMEOUT_SECONDS=5
PAYMENT_DB_CONNECT_TIMEOUT_SECONDS=3
PAYMENT_DB_LOCK_TIMEOUT_MS=2000
PAYMENT_DB_STATEMENT_TIMEOUT_MS=10000
PAYMENT_IDEMPOTENCY_TTL_SECONDS=86400
PAYMENT_LOG_LEVEL=INFO
PAYMENT_DOCS_ENABLED=true
