# Development placeholders are accepted only when PAYMENT_APP_ENV=local.
# Outside local, service/callback secrets must be configured separately and be at
# least 32 characters; otherwise the process refuses to start.
PAYMENT_APP_ENV=local
PAYMENT_DATABASE_URL=postgresql+psycopg://payment:payment@localhost:5438/payment
PAYMENT_SERVICE_TOKEN=local-development-token
PAYMENT_DB_POOL_SIZE=10
PAYMENT_DB_MAX_OVERFLOW=20
PAYMENT_DB_POOL_TIMEOUT_SECONDS=5
PAYMENT_DB_CONNECT_TIMEOUT_SECONDS=3
PAYMENT_DB_LOCK_TIMEOUT_MS=2000
PAYMENT_DB_STATEMENT_TIMEOUT_MS=10000
PAYMENT_IDEMPOTENCY_TTL_SECONDS=86400
PAYMENT_LOG_LEVEL=INFO
PAYMENT_DOCS_ENABLED=true

# Booking amount/currency evidence. Local keeps false for old clients; use true
# in integrated environments so PAYMENT_AMOUNT_MISMATCH is enforced.
PAYMENT_REQUIRE_BOOKING_EVIDENCE=false

# Provider callback (PAY-07).
PAYMENT_PROVIDER_CALLBACK_SECRET=local-provider-callback-secret
PAYMENT_PROVIDER_CALLBACK_REPLAY_WINDOW_SECONDS=300
PAYMENT_PROVIDER_CALLBACK_MAX_BODY_BYTES=65536

# UNKNOWN reconciliation (PAY-08).
PAYMENT_PROVIDER_RECONCILIATION_MAX_ATTEMPTS=10
PAYMENT_PROVIDER_RECONCILIATION_INITIAL_DELAY_SECONDS=5
PAYMENT_PROVIDER_RECONCILIATION_MAX_DELAY_SECONDS=300
PAYMENT_PROVIDER_RECONCILIATION_BATCH_SIZE=20
PAYMENT_PROVIDER_RECONCILIATION_POLL_SECONDS=5

# Outbox relay. Leave URL empty to log envelopes. When URL is set, secret is
# mandatory and signs every delivery.
PAYMENT_OUTBOX_BATCH_SIZE=20
PAYMENT_OUTBOX_MAX_ATTEMPTS=8
PAYMENT_OUTBOX_POLL_SECONDS=5
PAYMENT_OUTBOX_WEBHOOK_URL=
PAYMENT_OUTBOX_WEBHOOK_SECRET=
PAYMENT_OUTBOX_WEBHOOK_TIMEOUT_SECONDS=5
