TICKET_APP_ENV=local
TICKET_DATABASE_URL=postgresql+psycopg://ticket:ticket@localhost:5439/ticket
TICKET_SERVICE_TOKEN=local-development-token
TICKET_QR_SIGNING_KEY=local-development-qr-signing-key
TICKET_DB_POOL_SIZE=10
TICKET_DB_MAX_OVERFLOW=20
TICKET_DB_POOL_TIMEOUT_SECONDS=5
TICKET_DB_CONNECT_TIMEOUT_SECONDS=3
TICKET_DB_LOCK_TIMEOUT_MS=2000
TICKET_DB_STATEMENT_TIMEOUT_MS=10000
TICKET_IDEMPOTENCY_TTL_SECONDS=86400
TICKET_LOG_LEVEL=INFO
TICKET_DOCS_ENABLED=true
