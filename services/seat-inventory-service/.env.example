SEAT_APP_ENV=local
SEAT_LOG_LEVEL=INFO
SEAT_DATABASE_URL=postgresql+psycopg://seat_inventory:seat_inventory@localhost:5433/seat_inventory
SEAT_SERVICE_TOKEN=replace-with-a-secret
SEAT_SOAP_PUBLIC_URL=http://localhost:8003/soap
SEAT_WSDL_PATH=../../contracts/seat-inventory.wsdl
SEAT_XSD_PATH=../../contracts/seat-inventory.xsd
SEAT_MAX_XML_BYTES=262144
SEAT_MIN_HOLD_SECONDS=30
SEAT_DEFAULT_HOLD_SECONDS=600
SEAT_MAX_HOLD_SECONDS=900
SEAT_MAX_EXTENSION_SECONDS=300
SEAT_MAX_EXTEND_COUNT=1
SEAT_EXPIRY_WORKER_ENABLED=true
SEAT_EXPIRY_BATCH_SIZE=100
SEAT_EXPIRY_POLL_SECONDS=3
SEAT_DB_LOCK_TIMEOUT_MS=1500
SEAT_DB_STATEMENT_TIMEOUT_MS=5000
SEAT_IDEMPOTENCY_TTL_SECONDS=86400
SEAT_DB_POOL_SIZE=20
SEAT_DB_MAX_OVERFLOW=20
SEAT_SQL_ECHO=false
