<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:event-ticketing:seat-inventory:v1"
    targetNamespace="urn:event-ticketing:seat-inventory:v1"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    version="1.0">

  <xs:simpleType name="Identifier">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="128"/>
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._:-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SeatStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="AVAILABLE"/>
      <xs:enumeration value="HELD"/>
      <xs:enumeration value="SOLD"/>
      <xs:enumeration value="BLOCKED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ReservationStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACTIVE"/>
      <xs:enumeration value="CONFIRMED"/>
      <xs:enumeration value="RELEASED"/>
      <xs:enumeration value="EXPIRED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="RequestContext">
    <xs:sequence>
      <xs:element name="correlationId" type="tns:Identifier"/>
      <xs:element name="idempotencyKey" type="tns:Identifier" minOccurs="0"/>
      <xs:element name="callerService" type="tns:Identifier"/>
      <xs:element name="actorId" type="tns:Identifier" minOccurs="0"/>
      <xs:element name="schemaVersion" type="xs:string" fixed="1.0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SeatIdList">
    <xs:sequence>
      <xs:element name="seatId" type="tns:Identifier" minOccurs="1" maxOccurs="50"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OptionalSeatIdList">
    <xs:sequence>
      <xs:element name="seatId" type="tns:Identifier" minOccurs="0" maxOccurs="50"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReservationIdList">
    <xs:sequence>
      <xs:element name="reservationId" type="tns:Identifier" minOccurs="0" maxOccurs="1000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Seat">
    <xs:sequence>
      <xs:element name="seatId" type="tns:Identifier"/>
      <xs:element name="section" type="xs:string"/>
      <xs:element name="rowLabel" type="xs:string"/>
      <xs:element name="seatNumber" type="xs:string"/>
      <xs:element name="ticketType" type="xs:string"/>
      <xs:element name="status" type="tns:SeatStatus"/>
      <xs:element name="resourceVersion" type="xs:positiveInteger"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SeatCollection">
    <xs:sequence>
      <xs:element name="seat" type="tns:Seat" minOccurs="0" maxOccurs="20000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Reservation">
    <xs:sequence>
      <xs:element name="reservationId" type="tns:Identifier"/>
      <xs:element name="bookingId" type="tns:Identifier"/>
      <xs:element name="eventId" type="tns:Identifier"/>
      <xs:element name="seatIds" type="tns:SeatIdList"/>
      <xs:element name="status" type="tns:ReservationStatus"/>
      <xs:element name="expiresAt" type="xs:dateTime"/>
      <xs:element name="extendCount" type="xs:nonNegativeInteger"/>
      <xs:element name="resourceVersion" type="xs:positiveInteger"/>
      <xs:element name="createdAt" type="xs:dateTime"/>
      <xs:element name="updatedAt" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SeatInventoryFaultType">
    <xs:sequence>
      <xs:element name="code" type="xs:string"/>
      <xs:element name="message" type="xs:string"/>
      <xs:element name="correlationId" type="tns:Identifier"/>
      <xs:element name="retryable" type="xs:boolean"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="SeatInventoryFault" type="tns:SeatInventoryFaultType"/>

  <xs:element name="GetSeatMapRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="context" type="tns:RequestContext"/>
        <xs:element name="eventId" type="tns:Identifier"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="GetSeatMapResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="correlationId" type="tns:Identifier"/>
        <xs:element name="eventId" type="tns:Identifier"/>
        <xs:element name="inventoryVersion" type="xs:positiveInteger"/>
        <xs:element name="generatedAt" type="xs:dateTime"/>
        <xs:element name="seats" type="tns:SeatCollection"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="CheckAvailabilityRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="context" type="tns:RequestContext"/>
        <xs:element name="eventId" type="tns:Identifier"/>
        <xs:element name="seatIds" type="tns:SeatIdList"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="CheckAvailabilityResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="correlationId" type="tns:Identifier"/>
        <xs:element name="eventId" type="tns:Identifier"/>
        <xs:element name="available" type="xs:boolean"/>
        <xs:element name="availableSeatIds" type="tns:OptionalSeatIdList"/>
        <xs:element name="unavailableSeatIds" type="tns:OptionalSeatIdList"/>
        <xs:element name="checkedAt" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ReserveSeatsRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="context" type="tns:RequestContext"/>
        <xs:element name="bookingId" type="tns:Identifier"/>
        <xs:element name="eventId" type="tns:Identifier"/>
        <xs:element name="seatIds" type="tns:SeatIdList"/>
        <xs:element name="holdSeconds" type="xs:positiveInteger" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ReserveSeatsResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="correlationId" type="tns:Identifier"/>
        <xs:element name="reservation" type="tns:Reservation"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetReservationRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="context" type="tns:RequestContext"/>
        <xs:element name="reservationId" type="tns:Identifier"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="GetReservationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="correlationId" type="tns:Identifier"/>
        <xs:element name="reservation" type="tns:Reservation"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ExtendReservationRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="context" type="tns:RequestContext"/>
        <xs:element name="reservationId" type="tns:Identifier"/>
        <xs:element name="expectedVersion" type="xs:positiveInteger"/>
        <xs:element name="extensionSeconds" type="xs:positiveInteger"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ExtendReservationResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="correlationId" type="tns:Identifier"/>
        <xs:element name="reservation" type="tns:Reservation"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ConfirmSeatsRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="context" type="tns:RequestContext"/>
        <xs:element name="reservationId" type="tns:Identifier"/>
        <xs:element name="expectedVersion" type="xs:positiveInteger"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ConfirmSeatsResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="correlationId" type="tns:Identifier"/>
        <xs:element name="reservation" type="tns:Reservation"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ReleaseSeatsRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="context" type="tns:RequestContext"/>
        <xs:element name="reservationId" type="tns:Identifier"/>
        <xs:element name="reasonCode" type="tns:Identifier" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ReleaseSeatsResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="correlationId" type="tns:Identifier"/>
        <xs:element name="reservation" type="tns:Reservation"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ExpireReservationsRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="context" type="tns:RequestContext"/>
        <xs:element name="batchSize" type="xs:positiveInteger" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ExpireReservationsResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="correlationId" type="tns:Identifier"/>
        <xs:element name="expiredCount" type="xs:nonNegativeInteger"/>
        <xs:element name="reservationIds" type="tns:ReservationIdList"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
