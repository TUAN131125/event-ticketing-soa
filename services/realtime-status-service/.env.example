# Local defaults. Copy to .env and provide real credentials for shared environments.
REALTIME_APP_ENV=local
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8008
REALTIME_LOG_LEVEL=INFO
REALTIME_DOCS_ENABLED=true
REALTIME_ALLOWED_WS_ORIGINS=http://localhost:3000,http://localhost:3001
REALTIME_JWT_ISSUER=http://localhost:8009
REALTIME_JWT_AUDIENCE=event-ticketing-api
REALTIME_JWKS_URL=http://localhost:8009/.well-known/jwks.json
REALTIME_JWT_ALGORITHM=RS256
REALTIME_JWKS_TIMEOUT_SECONDS=2
REALTIME_JWKS_CACHE_TTL_SECONDS=300
# ESB WebSocket tickets are signed with the ESB private key; Realtime receives only this public key.
REALTIME_WS_TICKET_PUBLIC_KEY_PATH=/run/secrets/esb-ws-ticket-public.pem
REALTIME_WS_TICKET_ISSUER=booking-orchestrator
REALTIME_WS_TICKET_AUDIENCE=realtime-status-service
REALTIME_WS_TICKET_KEY_ID=
REALTIME_WS_TICKET_MAX_TTL_SECONDS=60
REALTIME_WS_TICKET_AUTH_TIMEOUT_SECONDS=5
REALTIME_WS_TICKET_REPLAY_MAX_ENTRIES=10000
REALTIME_INTERNAL_SERVICE_TOKEN=replace-for-any-shared-environment
REALTIME_ALLOWED_INTERNAL_CALLERS=booking-orchestrator,booking-service,payment-service,ticket-service
# Container-to-container URL. For host-local execution use http://localhost:8004/bookings/{bookingId}.
REALTIME_BOOKING_AUTHORIZATION_URL=http://booking:8004/bookings/{bookingId}
REALTIME_BOOKING_SERVICE_TOKEN=replace-with-booking-service-credential
REALTIME_BOOKING_CLIENT_TIMEOUT_SECONDS=2
REALTIME_ADMIN_ROLES=ADMIN
# Leave blank for the default single-process in-memory backend.
REALTIME_REDIS_URL=
REALTIME_REDIS_REQUIRED=false
REALTIME_REDIS_CHANNEL=realtime.booking-status.v1
REALTIME_HEARTBEAT_INTERVAL_SECONDS=20
REALTIME_IDLE_TIMEOUT_SECONDS=60
REALTIME_SEND_TIMEOUT_SECONDS=2
REALTIME_MAX_CONNECTIONS=1000
REALTIME_MAX_CONNECTIONS_PER_PRINCIPAL=5
REALTIME_MAX_CONNECTIONS_PER_IP=20
REALTIME_HANDSHAKE_RATE_LIMIT=30
REALTIME_HANDSHAKE_RATE_WINDOW_SECONDS=60
REALTIME_MAX_EVENT_BYTES=8192
REALTIME_MAX_CLIENT_MESSAGE_BYTES=1024
REALTIME_DEDUP_TTL_SECONDS=300
REALTIME_DEDUP_MAX_ENTRIES=10000
REALTIME_SEQUENCE_CACHE_TTL_SECONDS=1800
REALTIME_SEQUENCE_MAX_ENTRIES=10000
REALTIME_CLEANUP_INTERVAL_SECONDS=30
REALTIME_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=10
REALTIME_AUTHORITATIVE_BOOKING_URL_TEMPLATE=/api/bookings/{bookingId}
# Unsafe local-only compatibility. Never put long-lived access tokens in production URLs.
REALTIME_ALLOW_QUERY_TOKEN=false
REALTIME_INSECURE_AUTH_BYPASS=false
