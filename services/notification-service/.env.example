NOTIFICATION_APP_ENV=local
NOTIFICATION_LOG_LEVEL=INFO
NOTIFICATION_DATABASE_URL=postgresql+psycopg://notification_service:notification_service@localhost:5437/notification_service
NOTIFICATION_DB_POOL_SIZE=10
NOTIFICATION_DB_MAX_OVERFLOW=10
NOTIFICATION_SQL_ECHO=false

# NOT-02: bi mat dung chung voi ben phat webhook (ESB) de xac minh chu ky
# HMAC-SHA256 cua header X-Signature. BAT BUOC doi gia tri that khi trien khai.
NOTIFICATION_WEBHOOK_SHARED_SECRET=dev-only-shared-secret-change-me

# Xac thuc Bearer JWT (RS256) cho cac endpoint Admin/Ops - tro toi file
# public key CUNG voi key ma Identity Service dung de ky token (vd mount
# chung 1 volume ./keys/identity-public.pem vao ca 2 container).
NOTIFICATION_JWT_PUBLIC_KEY_PATH=/app/keys/identity-public.pem
NOTIFICATION_JWT_ISSUER=identity-service
NOTIFICATION_JWT_AUDIENCE=event-ticketing-soa
