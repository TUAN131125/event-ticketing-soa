IDENTITY_APP_ENV=local
IDENTITY_DATABASE_URL=postgresql+psycopg://identity:change-me@localhost:5434/identity
IDENTITY_ISSUER=http://localhost:8009
IDENTITY_AUDIENCE=event-ticketing-api
IDENTITY_PRIVATE_KEY_PATH=./keys/private.pem
IDENTITY_PUBLIC_KEY_PATH=./keys/public.pem
IDENTITY_KEY_ID=identity-local-1
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
IDENTITY_REFRESH_TOKEN_TTL_SECONDS=604800
IDENTITY_COOKIE_SECURE=false
IDENTITY_COOKIE_SAMESITE=lax
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
IDENTITY_LOGIN_WINDOW_SECONDS=60
IDENTITY_LOGIN_RATE_LIMIT=10
IDENTITY_LOCKOUT_THRESHOLD=5
IDENTITY_LOCKOUT_SECONDS=300
IDENTITY_LOG_LEVEL=INFO
IDENTITY_DOCS_ENABLED=true
