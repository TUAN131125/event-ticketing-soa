# Load these values into the process environment for direct local execution.
IDENTITY_APP_ENV=local

# PostgreSQL installed directly on this computer (default PostgreSQL port 5432).
IDENTITY_DATABASE_URL=postgresql+psycopg://identity:change-me@localhost:5432/identity

# Use a separate test database because integration tests truncate Identity tables.
IDENTITY_TEST_DATABASE_URL=postgresql+psycopg://identity:change-me@localhost:5432/identity_test

# Local service identity. The ESB must use this exact issuer when integrated locally.
IDENTITY_ISSUER=http://localhost:8009
IDENTITY_AUDIENCE=public-esb

IDENTITY_PRIVATE_KEY_PATH=./keys/private.pem
IDENTITY_PUBLIC_KEY_PATH=./keys/public.pem
IDENTITY_OPENAPI_PATH=../../contracts/identity-service.yaml
IDENTITY_KEY_ID=identity-local-1
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
IDENTITY_REFRESH_TOKEN_TTL_SECONDS=604800
IDENTITY_COOKIE_SECURE=false
IDENTITY_COOKIE_SAMESITE=lax
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
IDENTITY_LOGIN_WINDOW_SECONDS=60
IDENTITY_LOGIN_RATE_LIMIT=10
IDENTITY_LOCKOUT_THRESHOLD=5
IDENTITY_LOCKOUT_SECONDS=300
IDENTITY_LOG_LEVEL=INFO
IDENTITY_DOCS_ENABLED=true
