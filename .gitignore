# Environment and secret material
**/.env
**/.env.*
!**/.env.example
local-secrets/*
!local-secrets/.gitkeep
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.p12
**/*.pfx

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Node and frontend build output
**/node_modules/
**/.vite/
**/.turbo/
**/.next/
**/*.tsbuildinfo
**/coverage/

# Reports, logs and build artifacts
**/*.log
**/.coverage
**/coverage.xml
**/htmlcov/
**/reports/
**/test-results/
**/playwright-report/
**/.cache/
/dist/
.db-backups/
