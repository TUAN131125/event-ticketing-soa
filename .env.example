COMPOSE_PROJECT_NAME=event-ticketing-soa

# Local-only bootstrap credentials. Copy this file to .env and replace values
# before using any shared environment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-admin-password
POSTGRES_DB=postgres

IDENTITY_DB_NAME=identity
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=local-identity-db-password
CUSTOMER_DB_NAME=customer
CUSTOMER_DB_USER=customer
CUSTOMER_DB_PASSWORD=local-customer-db-password
EVENT_DB_NAME=event
EVENT_DB_USER=event
EVENT_DB_PASSWORD=local-event-db-password
SEAT_DB_NAME=seat
SEAT_DB_USER=seat
SEAT_DB_PASSWORD=local-seat-db-password
BOOKING_DB_NAME=booking
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=local-booking-db-password
PAYMENT_DB_NAME=payment
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=local-payment-db-password
TICKET_DB_NAME=ticket
TICKET_DB_USER=ticket
TICKET_DB_PASSWORD=local-ticket-db-password
NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=local-notification-db-password
ORCHESTRATOR_DB_NAME=orchestrator
ORCHESTRATOR_DB_USER=orchestrator
ORCHESTRATOR_DB_PASSWORD=local-orchestrator-db-password

IDENTITY_APP_ENV=local
IDENTITY_DATABASE_URL=postgresql+psycopg://identity:local-identity-db-password@postgres:5432/identity
IDENTITY_TEST_DATABASE_URL=postgresql+psycopg://identity:local-identity-db-password@postgres:5432/identity
IDENTITY_ISSUER=http://localhost:8009
IDENTITY_AUDIENCE=public-esb
IDENTITY_PRIVATE_KEY_FILE=/run/secrets/identity-private.pem
IDENTITY_PUBLIC_KEY_FILE=/run/secrets/identity-public.pem
IDENTITY_OPENAPI_PATH=/app/contracts/identity-service.yaml
IDENTITY_KEY_ID=identity-local-1
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
IDENTITY_COOKIE_SECURE=false
IDENTITY_COOKIE_SAMESITE=lax
IDENTITY_DOCS_ENABLED=true

CUSTOMER_APP_ENV=local
CUSTOMER_DATABASE_URL=postgresql+psycopg://customer:local-customer-db-password@postgres:5432/customer
CUSTOMER_SERVICE_JWT_PUBLIC_KEY_PATH=/run/secrets/esb-internal-public.pem
CUSTOMER_SERVICE_JWT_ISSUER=event-ticketing-internal
CUSTOMER_ALLOWED_SERVICE_SUBJECTS=booking-orchestrator,booking-service

EVENT_APP_ENV=local
EVENT_DATABASE_URL=postgresql+psycopg://event:local-event-db-password@postgres:5432/event
EVENT_SERVICE_JWT_PUBLIC_KEY_PATH=/run/secrets/esb-internal-public.pem
EVENT_SERVICE_JWT_ISSUER=event-ticketing-internal
EVENT_ALLOWED_SERVICE_SUBJECTS=booking-orchestrator

SEAT_APP_ENV=local
SEAT_DATABASE_URL=postgresql+psycopg://seat:local-seat-db-password@postgres:5432/seat
SEAT_SERVICE_JWT_PUBLIC_KEY_PATH=/run/secrets/esb-internal-public.pem
SEAT_SERVICE_JWT_ISSUER=event-ticketing-internal
SEAT_ALLOWED_SERVICE_SUBJECTS=booking-orchestrator
SEAT_SOAP_PUBLIC_URL=http://localhost:8003/soap
SEAT_WSDL_PATH=/app/contracts/seat-inventory.wsdl
SEAT_XSD_PATH=/app/contracts/seat-inventory.xsd

BOOKING_APP_ENV=local
BOOKING_DATABASE_URL=postgresql+psycopg://booking:local-booking-db-password@postgres:5432/booking
BOOKING_SERVICE_JWT_PUBLIC_KEY_PATH=/run/secrets/esb-internal-public.pem
BOOKING_SERVICE_JWT_PRIVATE_KEY_PATH=/run/secrets/esb-internal-private.pem
BOOKING_SERVICE_JWT_ISSUER=event-ticketing-internal
BOOKING_SERVICE_JWT_SUBJECT=booking-service
BOOKING_SERVICE_JWT_KEY_ID=esb-internal-1
BOOKING_ALLOWED_SERVICE_SUBJECTS=booking-orchestrator,realtime-status-service
BOOKING_CUSTOMER_SERVICE_URL=http://customer:8001

PAYMENT_APP_ENV=local
PAYMENT_DATABASE_URL=postgresql+psycopg://payment:local-payment-db-password@postgres:5432/payment
PAYMENT_SERVICE_JWT_PUBLIC_KEY_PATH=/run/secrets/esb-internal-public.pem
PAYMENT_SERVICE_JWT_ISSUER=event-ticketing-internal
PAYMENT_ALLOWED_SERVICE_SUBJECTS=booking-orchestrator
PAYMENT_PROVIDER_HMAC_SECRET=local-payment-provider-hmac-secret-change-me

TICKET_APP_ENV=local
TICKET_DATABASE_URL=postgresql+psycopg://ticket:local-ticket-db-password@postgres:5432/ticket
TICKET_SERVICE_JWT_PUBLIC_KEY_PATH=/run/secrets/esb-internal-public.pem
TICKET_SERVICE_JWT_ISSUER=event-ticketing-internal
TICKET_ALLOWED_SERVICE_SUBJECTS=booking-orchestrator
TICKET_QR_SIGNING_KEY=local-ticket-qr-signing-key-change-me

NOTIFICATION_APP_ENV=local
NOTIFICATION_DATABASE_URL=postgresql+psycopg://notification:local-notification-db-password@postgres:5432/notification
NOTIFICATION_SERVICE_JWT_PUBLIC_KEY_PATH=/run/secrets/esb-internal-public.pem
NOTIFICATION_SERVICE_JWT_ISSUER=event-ticketing-internal
NOTIFICATION_ALLOWED_SERVICE_SUBJECTS=booking-orchestrator
NOTIFICATION_WEBHOOK_HMAC_SECRET=local-notification-webhook-hmac-change-me

ESB_ENVIRONMENT=development
ESB_DATABASE_URL=postgresql+asyncpg://orchestrator:local-orchestrator-db-password@postgres:5432/orchestrator
ESB_IDENTITY_JWKS_URL=http://identity:8009/.well-known/jwks.json
ESB_IDENTITY_EXPECTED_ISSUER=http://localhost:8009
ESB_IDENTITY_EXPECTED_AUDIENCE=public-esb
ESB_CUSTOMER_SERVICE_URL=http://customer:8001
ESB_EVENT_SERVICE_URL=http://event:8002
ESB_SEAT_SERVICE_URL=http://seat:8003/soap
ESB_SEAT_PROVIDER_XSD_PATH=/app/contracts/seat-inventory.xsd
ESB_BOOKING_SERVICE_URL=http://booking:8004
ESB_PAYMENT_SERVICE_URL=http://payment:8005
ESB_TICKET_SERVICE_URL=http://ticket:8006
ESB_NOTIFICATION_SERVICE_URL=http://notification:8007
ESB_NOTIFICATION_WEBHOOK_SECRET=local-notification-webhook-hmac-change-me
ESB_REALTIME_SERVICE_URL=http://realtime:8008
ESB_INTERNAL_SERVICE_ISSUER=event-ticketing-internal
ESB_INTERNAL_SERVICE_SUBJECT=booking-orchestrator
ESB_INTERNAL_SERVICE_PRIVATE_KEY_PATH=/run/secrets/esb-internal-private.pem
ESB_INTERNAL_SERVICE_KEY_ID=esb-internal-1
ESB_WS_TICKET_PRIVATE_KEY_PATH=/run/secrets/esb-ws-ticket-private.pem
ESB_WS_TICKET_KEY_ID=esb-ws-1
ESB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ESB_DOCS_ENABLED=true

REALTIME_APP_ENV=local
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8008
REALTIME_ALLOWED_WS_ORIGINS=http://localhost:3000,http://localhost:3001
REALTIME_SERVICE_JWT_PUBLIC_KEY_PATH=/run/secrets/esb-internal-public.pem
REALTIME_SERVICE_JWT_ISSUER=event-ticketing-internal
REALTIME_ALLOWED_SERVICE_SUBJECTS=booking-orchestrator,booking-service,payment-service,ticket-service
REALTIME_WS_TICKET_PUBLIC_KEY_PATH=/run/secrets/esb-ws-ticket-public.pem
REALTIME_WS_TICKET_ISSUER=booking-orchestrator
REALTIME_WS_TICKET_AUDIENCE=realtime-status-service
REALTIME_WS_TICKET_KEY_ID=esb-ws-1
REALTIME_REDIS_REQUIRED=false
REALTIME_DOCS_ENABLED=true

# One-shot local/demo provisioning (compose profile `seed`). Seeding is opt-in and only
# ever talks to Event and Seat through their canonical contracts.
SEED_LOCAL_ENABLED=true
SEED_EVENT_BASE_URL=http://event:8002
SEED_SEAT_SOAP_URL=http://seat:8003/soap
SEED_SERVICE_JWT_PRIVATE_KEY_PATH=/run/secrets/esb-internal-private.pem
SEED_SERVICE_JWT_ISSUER=event-ticketing-internal
SEED_SERVICE_JWT_SUBJECT=booking-orchestrator
SEED_SERVICE_JWT_KEY_ID=esb-internal-1
SEED_EVENT_AUDIENCE=event-service
SEED_SEAT_AUDIENCE=seat-inventory-service
SEED_TIMEOUT_SECONDS=10

VITE_IDENTITY_API_URL=http://localhost:8009
VITE_ESB_API_URL=http://localhost:8000
VITE_REALTIME_WS_URL=ws://localhost:8008
