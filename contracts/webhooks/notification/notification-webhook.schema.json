{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-ticketing:notification-webhook:v1",
  "title": "NotificationWebhook",
  "description": "Generic signed notification ingress payload. HMAC and timestamp headers are defined by the Notification OpenAPI.",
  "x-contract-status": "canonical-v1",
  "x-designed-baseline-version": "1.0.0",
  "allOf": [
    {
      "$ref": "urn:event-ticketing:event-envelope:v1"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "enum": [
            "booking.confirmed",
            "booking.failed",
            "event.changed",
            "ticket.issued"
          ]
        }
      }
    }
  ],
  "examples": [
    {
      "eventId": "EVTMSG-001",
      "eventType": "booking.confirmed",
      "schemaVersion": 1,
      "occurredAt": "2026-08-03T03:00:00Z",
      "correlationId": "corr-1234567890abcdef",
      "aggregateId": "BKG-001",
      "data": {
        "bookingId": "BKG-001",
        "ticketIds": [
          "TKT-001"
        ]
      }
    }
  ],
  "x-origin": "phase5-machine-baseline"
}
