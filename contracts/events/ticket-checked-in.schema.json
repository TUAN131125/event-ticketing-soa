{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-ticketing.example/contracts/events/ticket-checked-in.schema.json",
  "title": "ticket.checked-in",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "aggregateType", "aggregateId", "aggregateVersion", "correlationId", "occurredAt", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "ticket.checked-in"},
    "aggregateType": {"const": "Ticket"},
    "aggregateId": {"$ref": "#/$defs/identifier"},
    "aggregateVersion": {"type": "integer", "minimum": 2},
    "correlationId": {"$ref": "#/$defs/identifier"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticketId", "bookingId", "customerId", "eventId", "paymentId", "seatId", "seatLabel", "ticketType", "status", "qrVersion", "resourceVersion", "occurredAt", "gateId", "checkedInBy"],
      "properties": {
        "ticketId": {"$ref": "#/$defs/identifier"},
        "bookingId": {"$ref": "#/$defs/identifier"},
        "customerId": {"$ref": "#/$defs/identifier"},
        "eventId": {"$ref": "#/$defs/identifier"},
        "paymentId": {"$ref": "#/$defs/identifier"},
        "seatId": {"$ref": "#/$defs/identifier"},
        "seatLabel": {"$ref": "#/$defs/identifier"},
        "ticketType": {"$ref": "#/$defs/identifier"},
        "status": {"const": "CHECKED_IN"},
        "qrVersion": {"type": "integer", "minimum": 1},
        "resourceVersion": {"type": "integer", "minimum": 2},
        "occurredAt": {"type": "string", "format": "date-time"},
        "gateId": {"$ref": "#/$defs/identifier"},
        "checkedInBy": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
