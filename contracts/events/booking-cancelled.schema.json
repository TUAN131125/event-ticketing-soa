{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-ticketing.example/contracts/events/booking-cancelled.schema.json",
  "title": "booking.cancelled",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "correlationId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "booking.cancelled"},
    "aggregateType": {"const": "Booking"},
    "aggregateId": {"$ref": "#/$defs/identifier"},
    "aggregateVersion": {"type": "integer", "minimum": 2},
    "correlationId": {"$ref": "#/$defs/identifier"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookingId",
        "customerId",
        "eventId",
        "reservationId",
        "seatIds",
        "status",
        "paymentStatus",
        "paymentId",
        "totalAmount",
        "currency",
        "resourceVersion",
        "occurredAt",
        "reason"
      ],
      "properties": {
        "bookingId": {"$ref": "#/$defs/identifier"},
        "customerId": {"$ref": "#/$defs/identifier"},
        "eventId": {"$ref": "#/$defs/identifier"},
        "reservationId": {"$ref": "#/$defs/identifier"},
        "seatIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "status": {"const": "CANCELLED"},
        "paymentStatus": {
          "enum": ["PENDING", "FAILED", "REFUNDED"]
        },
        "paymentId": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "totalAmount": {"$ref": "#/$defs/money"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "resourceVersion": {"type": "integer", "minimum": 2},
        "occurredAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$"
    }
  }
}
