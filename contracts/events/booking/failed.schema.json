{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-ticketing:event:booking.failed:v1",
  "title": "booking.failed",
  "description": "Official design-derived v1 producer-owned schema for booking.failed. Delivery is at-least-once and consumers deduplicate by eventId.",
  "x-contract-status": "canonical-v1",
  "x-designed-baseline-version": "1.0.0",
  "x-origin": "design-derived-v1",
  "allOf": [
    {
      "$ref": "urn:event-ticketing:event-envelope:v1"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "booking.failed"
        },
        "schemaVersion": {
          "const": 1
        },
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookingId",
        "status",
        "reasonCode",
        "compensationState",
        "resourceVersion"
      ],
      "properties": {
        "bookingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "status": {
          "const": "FAILED"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{2,64}$"
        },
        "compensationState": {
          "type": "string",
          "enum": [
            "NOT_REQUIRED",
            "COMPLETED",
            "PENDING"
          ]
        },
        "resourceVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "EVTMSG-001",
      "eventType": "booking.failed",
      "schemaVersion": 1,
      "occurredAt": "2026-08-03T03:00:00Z",
      "correlationId": "corr-1234567890abcdef",
      "aggregateId": "BOOKING-001",
      "data": {
        "bookingId": "BOOKING-001",
        "status": "FAILED",
        "reasonCode": "PROCESSING_FAILED",
        "compensationState": "NOT_REQUIRED",
        "resourceVersion": 1
      }
    }
  ]
}
