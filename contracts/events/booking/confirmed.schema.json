{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-ticketing:event:booking.confirmed:v1",
  "title": "booking.confirmed",
  "description": "Official design-derived v1 producer-owned schema for booking.confirmed. Delivery is at-least-once and consumers deduplicate by eventId.",
  "x-contract-status": "canonical-v1",
  "x-designed-baseline-version": "1.0.0",
  "x-origin": "design-derived-v1",
  "allOf": [
    {
      "$ref": "urn:event-ticketing:event-envelope:v1"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "booking.confirmed"
        },
        "schemaVersion": {
          "const": 1
        },
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookingId",
        "status",
        "reservationId",
        "paymentId",
        "ticketIds",
        "resourceVersion"
      ],
      "properties": {
        "bookingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "status": {
          "const": "CONFIRMED"
        },
        "reservationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "paymentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "ticketIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "resourceVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "EVTMSG-001",
      "eventType": "booking.confirmed",
      "schemaVersion": 1,
      "occurredAt": "2026-08-03T03:00:00Z",
      "correlationId": "corr-1234567890abcdef",
      "aggregateId": "BOOKING-001",
      "data": {
        "bookingId": "BOOKING-001",
        "status": "CONFIRMED",
        "reservationId": "RESERVATION-001",
        "paymentId": "PAYMENT-001",
        "ticketIds": [
          "TKT-001"
        ],
        "resourceVersion": 1
      }
    }
  ]
}
