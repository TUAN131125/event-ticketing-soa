{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-ticketing:realtime-server-control:v1",
  "title": "RealtimeServerControlMessage",
  "description": "Realtime authentication, reconnect, resync, heartbeat and lifecycle controls. Authentication failures never expose raw tickets or token details.",
  "x-contract-status": "canonical-v1",
  "x-designed-baseline-version": "1.0.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bookingId",
        "authenticatedAt"
      ],
      "properties": {
        "type": {
          "const": "authenticated"
        },
        "bookingId": {
          "$ref": "#/$defs/bookingId"
        },
        "authenticatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "retryable"
      ],
      "properties": {
        "type": {
          "const": "authentication_failed"
        },
        "code": {
          "type": "string",
          "enum": [
            "TICKET_EXPIRED",
            "TICKET_REUSED",
            "TICKET_INVALID",
            "ACCESS_DENIED"
          ]
        },
        "retryable": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bookingId",
        "authoritativeUrl",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "resync_required"
        },
        "bookingId": {
          "$ref": "#/$defs/bookingId"
        },
        "authoritativeUrl": {
          "type": "string",
          "pattern": "^/api/bookings/[A-Za-z0-9._:-]+$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "reconnect",
            "sequence_gap",
            "history_unavailable"
          ]
        },
        "lastObservedSequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "heartbeatId",
        "sentAt"
      ],
      "properties": {
        "type": {
          "const": "heartbeat"
        },
        "heartbeatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bookingId"
      ],
      "properties": {
        "type": {
          "const": "connected"
        },
        "bookingId": {
          "$ref": "#/$defs/bookingId"
        }
      },
      "x-classification": "REVIEWED_RUNTIME_CANDIDATE"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "retryable"
      ],
      "properties": {
        "type": {
          "const": "shutdown"
        },
        "retryable": {
          "const": true
        }
      },
      "x-classification": "REVIEWED_RUNTIME_CANDIDATE"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "protocol_error"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{2,64}$"
        },
        "message": {
          "type": "string",
          "maxLength": 300
        }
      },
      "x-classification": "REVIEWED_RUNTIME_CANDIDATE"
    }
  ],
  "$defs": {
    "bookingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "examples": [
    {
      "type": "authenticated",
      "bookingId": "BKG-001",
      "authenticatedAt": "2026-08-03T03:00:05Z"
    },
    {
      "type": "authentication_failed",
      "code": "TICKET_EXPIRED",
      "retryable": false
    },
    {
      "type": "authentication_failed",
      "code": "TICKET_REUSED",
      "retryable": false
    },
    {
      "type": "resync_required",
      "bookingId": "BKG-001",
      "authoritativeUrl": "/api/bookings/BKG-001",
      "reason": "sequence_gap",
      "lastObservedSequence": 3
    }
  ],
  "x-origin": "official-design-v1"
}
