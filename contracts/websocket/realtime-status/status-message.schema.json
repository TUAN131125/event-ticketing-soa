{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-ticketing:realtime-message:v1",
  "title": "RealtimeMessage",
  "description": "Best-effort non-authoritative booking status projection.",
  "x-contract-status": "canonical-v1",
  "x-designed-baseline-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "bookingId",
    "status",
    "sequence",
    "occurredAt",
    "correlationId"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "bookingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "PENDING",
        "SEAT_RESERVED",
        "PAYMENT_PROCESSING",
        "CONFIRMED",
        "FAILED",
        "CANCELLED",
        "COMPENSATION_PENDING"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message": {
      "type": "string",
      "maxLength": 300
    }
  },
  "examples": [
    {
      "messageId": "MSG-001",
      "bookingId": "BKG-001",
      "status": "PAYMENT_PROCESSING",
      "sequence": 3,
      "occurredAt": "2026-08-03T03:00:00Z",
      "correlationId": "corr-1234567890abcdef",
      "message": "Payment result is being verified"
    }
  ],
  "x-origin": "phase5-machine-baseline"
}
