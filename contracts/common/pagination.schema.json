{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-ticketing:pagination:v1",
  "title": "PageMetadata",
  "description": "Page-number pagination metadata locked by the Phase-5 baseline.",
  "x-contract-status": "canonical-v1",
  "x-designed-baseline-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "page",
    "pageSize",
    "totalItems"
  ],
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "totalItems": {
      "type": "integer",
      "minimum": 0
    }
  },
  "examples": [
    {
      "page": 1,
      "pageSize": 20,
      "totalItems": 0
    }
  ],
  "x-origin": "phase5-machine-baseline"
}
