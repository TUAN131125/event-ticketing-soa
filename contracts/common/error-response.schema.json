{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:event-ticketing:error-response:v1",
  "title": "ErrorResponse",
  "x-contract-status": "canonical-v1",
  "x-designed-baseline-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "correlationId",
    "error"
  ],
  "properties": {
    "correlationId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Tt][Rr][Aa][Cc][Ee][Bb][Aa][Cc][Kk]|[Ss][Tt][Aa][Cc][Kk]|[Ii][Nn][Tt][Ee][Rr][Nn][Aa][Ll].?[Uu][Rr][Ll])"
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "correlationId": "corr-01J4M5Y4Q1S7K2P9",
      "traceId": null,
      "error": {
        "code": "BOOKING_NOT_FOUND",
        "message": "The booking was not found.",
        "retryable": false,
        "details": {}
      }
    }
  ],
  "x-invalidExamples": [
    {
      "correlationId": "corr-01J4M5Y4Q1S7K2P9",
      "traceId": null,
      "error": {
        "code": "INTERNAL_FAILURE",
        "message": "The request could not be processed.",
        "retryable": false,
        "details": {
          "traceback": "redacted"
        }
      }
    }
  ],
  "x-origin": "phase5-machine-baseline"
}
